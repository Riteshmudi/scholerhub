generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String
  createdAt      DateTime        @default(now())
  sessions       Session[]
  documents      Document[]
  conversations  Conversation[]
  quizzes        Quiz[]
  quizAttempts   QuizAttempt[]
  studyPlans     StudyPlan[]
  notes          Note[]
  progressEvents ProgressEvent[]
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Document {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  originalName    String
  mimeType        String
  size            Int
  pageCount       Int             @default(0)
  status          String          @default("processing")
  extractedText   String?
  summary         String?
  detailedSummary String?
  keyTopics       String?
  errorMessage    String?
  chunks          DocumentChunk[]
  createdAt       DateTime        @default(now())
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  pageNumber Int
  text       String
  createdAt  DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New Conversation")
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          String
  text            String
  citationDocName String?
  citationPage    Int?
  createdAt       DateTime     @default(now())
}

model Quiz {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  topic      String?
  difficulty String?
  questions  QuizQuestion[]
  attempts   QuizAttempt[]
  createdAt  DateTime       @default(now())
}

model QuizQuestion {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question    String
  options     String
  correctAnswer Int
  explanation String?
  createdAt   DateTime @default(now())
}

model QuizAttempt {
  id             String   @id @default(uuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        String
  score          Float
  totalQuestions Int
  createdAt      DateTime @default(now())
}

model StudyPlan {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  examDate  DateTime?
  planData  String
  createdAt DateTime  @default(now())
}

model Note {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String
  source     String?
  documentId String?
  createdAt  DateTime @default(now())
}

model ProgressEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  metadata  String?
  createdAt DateTime @default(now())
}