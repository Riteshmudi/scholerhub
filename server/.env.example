# Server environment variables
# Copy this file to server/.env and fill in values

# SQLite database path (relative to server/)
DATABASE_URL="file:./prisma/dev.db"

# Session secret for auth cookies (change in production)
SESSION_SECRET=dev-secret-change-me

# Port the backend Express server runs on
PORT=4000

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:3000

# Google Gemini API key - required for AI features only (chat, quizzes, notes, planner, summaries)
# Login and registration work WITHOUT this key.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
